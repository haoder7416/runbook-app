generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Runbook {
  id        Int      @id @default(autoincrement())
  title     String
  symptom   String
  action    String
  tags      String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}